{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkItDown Desktop",
  "version": "0.1.0",
  "identifier": "com.markitdown.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MarkItDown Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
