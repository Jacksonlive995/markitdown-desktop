# Optional: set a token before exposing the backend on a public VPS
API_TOKEN=

# Directory to store uploaded files and converted markdown results
DATA_DIR=./data

# Max concurrent conversion workers (keep 1-2 on CPU-only VPS)
MAX_WORKERS=2

# Max single file upload size in MB
MAX_UPLOAD_MB=200

# Optional: Default OpenAI-compatible VLM settings (can also be configured in Desktop Settings)
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_PROMPT=
